*~
\#*
.\#*
.DS_Store
compiled/
/doc/
polars/doc/

rust/target/
polars/private/compat/target/
**/*.rs.bk
# Ignore the staged copy of the shared object, but keep the committed
# per-platform prebuilt candidates that pkgs.rkt-lang.org installs from.
polars/native-libs/libcompat.*
# scripts/install-native-libs.sh's temporary copy, left by a killed install,
# and its marker beside each library it installed (#306), never committed.
polars/native-libs/.libcompat.*
!polars/native-libs/candidates/
# CI's record of the rust/ tree a candidate artifact was built from, and
# scripts/build-so.sh's of the toolchain that built it.
polars/native-libs/candidates/*/rust-tree
polars/native-libs/candidates/*/toolchain
# A native package's library, manifest and licences are added when it is
# staged from a built library (scripts/stage-native-package.rkt), never
# committed.
/polars-*/native-libs/
/polars-*/manifest.json
/polars-*/LICENSE-*
result
.racket-user/

compiled/
*.zo
*.dep
planet-cache/

# User-specific files
.racket/

# Local FFI scratch artifacts
/example.c
/libexample.dylib
/use-example.rkt
/use-ffi.rkt

# nycflights benchmark data, fetched by bench/run.sh
/bench/data/
__pycache__/
